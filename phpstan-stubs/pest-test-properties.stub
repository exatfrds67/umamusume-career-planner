<?php

/**
 * PHPStan stub file for Pest test properties.
 * 
 * This stub defines properties commonly used in Pest tests that are dynamically
 * assigned at runtime via beforeEach() hooks or the uses() function.
 * 
 * PHPStan sees Pest tests as extending PHPUnit\Framework\TestCase, so we need
 * to declare these properties on that class for static analysis.
 */

namespace PHPUnit\Framework {

    abstract class TestCase
    {
        /** @var mixed Parser instance used in various parsing tests */
        public $parser;
        
        /** @var mixed Service instance used in service tests */
        public $service;
        
        /** @var mixed Detector instance used in detection tests */
        public $detector;
        
        /** @var mixed Analysis service instance */
        public $analysisService;
        
        /** @var mixed Character model instance used in character-related tests */
        public $character;
        
        /** @var mixed Hint service instance used in skill hint tests */
        public $hintService;
        
        /** @var mixed Evolution service instance used in skill evolution tests */
        public $evolutionService;
        
        /** @var mixed Skill service instance used in skill-related tests */
        public $skillService;
        
        /** @var mixed Synergy scorer instance used in synergy calculation tests */
        public $synergyScorer;
        
        /** @var mixed User model instance used in authentication and authorization tests */
        public $user;
        
        /** @var mixed Image processor instance used in OCR and image processing tests */
        public $imageProcessor;
        
        /** @var mixed Prediction service instance used in prediction tests */
        public $predictionService;
        
        /** @var mixed MCP client instance used in MCP integration tests */
        public $mcpClient;
        
        /** @var mixed Conversation service instance used in AI chat tests */
        public $conversationService;
        
        /** @var mixed Analytics service instance used in analytics tests */
        public $analyticsService;
        
        /** @var mixed Export service instance used in export tests */
        public $exportService;
        
        /** @var mixed Feedback service instance used in feedback tests */
        public $feedbackService;

        /** @var mixed Support card instance used in support card tests */
        public $supportCard;

        /** @var mixed Trainee instance used in trainee-related tests */
        public $trainee;

        /** @var mixed Skill instance used in skill tests */
        public $skill;

        /** @var mixed Career run instance used in career tests */
        public $careerRun;

        /** @var mixed Request instance for HTTP tests */
        public $request;

        /** @var mixed Response instance for HTTP tests */
        public $response;

        /** @var mixed Config array for configuration tests */
        public $config;

        /** @var mixed Data array for data-driven tests */
        public $data;

        /** @var mixed Result from operation tests */
        public $result;

        /** @var mixed Item for collection/array tests */
        public $item;

        /** @var mixed Error message or error object for error tests */
        public $error;

        /** @var mixed Mock object for mocking tests */
        public $mock;

        /** @var mixed Factory instance for model creation tests */
        public $factory;

        /** @var mixed Agent instance for AI agent tests */
        public $agent;

        /** @var mixed Client instance for client tests */
        public $client;

        /** @var mixed Manager instance for manager service tests */
        public $manager;

        /** @var mixed Handler instance for handler tests */
        public $handler;

        /** @var mixed Provider instance for provider tests */
        public $provider;

        /** @var mixed Repository instance for repository tests */
        public $repository;

        /** @var mixed Calculator instance for calculation tests */
        public $calculator;

        /** @var mixed Validator instance for validation tests */
        public $validator;

        /** @var mixed Transformer instance for data transformation tests */
        public $transformer;

        /** @var mixed Cache for caching tests */
        public $cache;

        /** @var mixed Logger for logging tests */
        public $logger;

        /** @var mixed Events for event tests */
        public $events;

        /** @var mixed Queue for queue tests */
        public $queue;

        /** @var mixed Game mechanics engine instance for game mechanics tests */
        public $mechanicsEngine;

        /** @var mixed Advisor instance for advisory tests */
        public $advisor;

        /** @var mixed Engine instance for engine tests */
        public $engine;

        /** @var mixed Rule-based advisor instance for rule-based advisory tests */
        public $ruleBasedAdvisor;

        /** @var mixed Neuron AI service instance for AI tests */
        public $neuronAIService;

        /** @var mixed Accuracy tracker instance for accuracy tracking tests */
        public $accuracyTracker;

        /** @var mixed Critical detector instance for critical situation detection tests */
        public $criticalDetector;
    }
}


