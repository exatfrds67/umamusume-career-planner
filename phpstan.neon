includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  level: 9
  paths:
    - app
    - routes
    - tests

  excludePaths:
    - phpstan-stubs/
    # Duplicate file (canonical is in app/Services/MCP/)
    - app/MCP/
    # Test files with property override conflicts (declare typed properties that conflict with stub)
    - tests/Feature/MCP/ToolChainingWorkflowTest.php
    - tests/Unit/Services/CharacterStateServiceTest.php
    - tests/Unit/Services/MCP/AgentCommunicationServiceTest.php
    - tests/Unit/Services/MCP/AgentOrchestrationServiceTest.php
    - tests/Unit/Services/MCP/Tools/AWSPricingServiceTest.php
    # Test files with known structural issues (anonymous classes, mock return types)
    - tests/Feature/CacheManagementTest.php
    - tests/Integration/ExternalAPI/FailoverPerformanceTest.php
    - tests/Unit/Neuron/Agents/BaseAgentTest.php
    - tests/Unit/Services/ExternalAPI/ExternalAPIServiceTest.php
    # Test files with PHPUnit property override conflicts (cannot be ignored via ignoreErrors)
    - tests/Feature/Api/TrainingPredictionApiTest.php
    # Test support files with intentional loose typing for test flexibility
    - tests/Support/FakeRedis.php

  scanFiles:
    - phpstan-stubs/pest-test-properties.stub

  treatPhpDocTypesAsCertain: false

  reportUnmatchedIgnoredErrors: false

  ignoreErrors:
    # ============================================================
    # TEST FILE IGNORES
    # ============================================================
    # Pest test files use dynamic properties assigned in beforeEach() hooks
    -
      message: '#Cannot call method .+ on mixed\.#'
      paths:
        - tests/
    -
      message: '#Cannot access property .+ on mixed\.#'
      paths:
        - tests/
    -
      message: '#Cannot access offset .+ on mixed\.#'
      paths:
        - tests/
    -
      message: '#Parameter .+ of (method|function) .+ expects .+, mixed given\.#'
      paths:
        - tests/
    # Pest's TestCall and HigherOrderTapProxy dynamic properties
    -
      message: '#Access to an undefined property Pest\\.*#'
      paths:
        - tests/
    -
      message: '#Access to an undefined property PHPUnit\\Framework\\TestCase::\$.+#'
      paths:
        - tests/
    # Laravel TestCase methods used in Pest tests via uses() trait
    -
      message: '#Call to an undefined method PHPUnit\\Framework\\TestCase::.+#'
      paths:
        - tests/
    # Pest tests extending Test classes with undefined methods
    -
      message: '#Call to an undefined method Tests\\.+::.+#'
      paths:
        - tests/
    # Pest calls returning dynamic types
    -
      message: '#Call to an undefined method Pest\\.+#'
      paths:
        - tests/
    # Offset access issues in tests (dynamic arrays from API responses)
    -
      message: '#Offset .+ (might not exist|does not exist) on .+#'
      paths:
        - tests/
    # Template type resolution in tests
    -
      message: '#Unable to resolve the template type .+#'
      paths:
        - tests/
    # env() usage in tests (sometimes necessary for environment checks)
    -
      message: "#Called 'env' outside of the config directory#"
      paths:
        - tests/
    # Argument type issues in tests with mocked data
    -
      message: '#Parameter .+ of (method|class|static method|function) .+ expects .+, .+ given\.#'
      paths:
        - tests/
    # Mockery expectation chain methods (andReturn, once, times, etc.)
    -
      message: '#Call to an undefined method Mockery\\ExpectationInterface\|Mockery\\HigherOrderMessage::.+#'
      paths:
        - tests/
    # Pest expectation extensions rely on Pest's bound closure $this in tests/Pest.php
    -
      message: '#Undefined variable: \$this#'
      paths:
        - tests/Pest.php
    # Property/method access on nullable types in tests
    -
      message: '#Cannot (call method|access property) .+ on .+\|null\.#'
      paths:
        - tests/
    
    # Mockery methods (union type patterns - broader pattern)
    - '#Call to an undefined method Mockery.+::#'

    # ReflectionType::getName() method (PHP 7.1+ method, PHPStan may not recognize in some contexts)
    -
      message: '#Call to an undefined method ReflectionType::getName\(\)#'
      paths:
        - tests/Unit/Services/

    # Browser tests: Pest Browser API submit() invoked with 1 parameter
    -
      message: '#Method .+::submit\(\) invoked with 1 parameter, 0 required\.#'
      paths:
        - tests/Browser/
    # Dead catch blocks in tests are acceptable (testing for unexpected exceptions)
    -
      message: '#Dead catch - .+ is never thrown in the try block\.#'
      paths:
        - tests/
    # Performance/benchmark tests intentionally call methods for side effects
    -
      message: '#Call to method .+ on a separate line has no effect\.#'
      paths:
        - tests/
    # Property tests may have ternary always true due to generator patterns
    -
      message: '#Ternary operator condition is always true\.#'
      paths:
        - tests/
    # Null coalesce on always-existing offset is acceptable in tests for safety
    -
      message: '#Offset .+ on .+ in isset\(\) always exists and is not (nullable|null)\.#'
      paths:
        - tests/
    # Cannot access offset on array|false (including shaped arrays) in tests
    -
      message: '#Cannot access offset .+ on array.+\|false\.#'
      paths:
        - tests/

    # Null coalesce on never-existing offset is acceptable in tests for safety
    -
      message: '#Offset .+ on .+ on left side of \?\? does not exist\.#'
      paths:
        - tests/

    # === CoverageReporter: mixed values from array<string, mixed> summary ===
    -
      message: '#Part .+ \(mixed\) of encapsed string cannot be cast to string\.#'
      paths:
        - app/Services/Testing/CoverageReporter.php
    -
      message: '#Binary operation ".+" between .+ and mixed results in an error\.#'
      paths:
        - app/Services/Testing/CoverageReporter.php
    -
      message: '#Property App\\Services\\Testing\\CoverageReporter::\$performance .+ does not accept array<int, mixed>\.#'
    -
      message: '#Parameter \#2 \$callback of function array_filter expects .+, Closure.+mixed.+ given\.#'
      paths:
        - app/Services/Testing/CoverageReporter.php

    # === RouteDiscoveryService: known typing limitations ===
    -
      message: '#Call to function is_string\(\) with string will always evaluate to true\.#'
      paths:
        - app/Services/Testing/RouteDiscoveryService.php
    -
      message: '#Argument of an invalid type .+ supplied for foreach, only iterables are supported\.#'
      paths:
        - app/Services/Testing/RouteDiscoveryService.php
    -
      message: '#Possibly invalid array key type .+#'
      paths:
        - app/Services/Testing/RouteDiscoveryService.php
    -
      message: '#Parameter \#3 \$subject of function str_replace expects .+, mixed given\.#'
      paths:
        - app/Services/Testing/RouteDiscoveryService.php
    -
      message: '#Binary operation ".+" between .+ and mixed results in an error\.#'
      paths:
        - app/Services/Testing/RouteDiscoveryService.php

    # === BelongsTo covariance: known Laravel/PHPStan template type issue ===
    -
      message: '#Method .+ should return Illuminate\\Database\\Eloquent\\Relations\\BelongsTo.+ but returns Illuminate\\Database\\Eloquent\\Relations\\BelongsTo.+\$this\(.+\)>\.#'
      paths:
        - app/Models/

    # === Collection covariance in AIDashboardService ===
    -
      message: '#Template type TValue on class Illuminate\\Support\\Collection is not covariant\.#'

    # === ArrayObject covariance in AccessibilitySettings ===
    -
      message: '#Template type TValue on class ArrayObject is not covariant\.#'

    # === ComparisonReportService: known mixed-value and empty-array issues ===
    -
      message: '#Parameter \#1 .+\$arg1 of function (max|min) expects non-empty-array, array.+ given\.#'
      paths:
        - app/Services/Simulation/ComparisonReportService.php
    -
      message: '#Method .+ComparisonReportService::generateReport\(\) should return .+ but returns .+#'
    -
      message: '#Cannot cast mixed to (float|string|int)\.#'
      paths:
        - app/Services/Simulation/ComparisonReportService.php
    -
      message: '#Cannot access offset .+ on mixed\.#'
      paths:
        - app/Services/Simulation/ComparisonReportService.php

    # === PatternDashboard: array_map with string callable ===
    -
      message: '#Parameter \#1 \$callback of function array_map expects .+, .+intval.+ given\.#'

    # === ShareLinkService: mixed cast errors and return type ===
    -
      message: '#Cannot cast mixed to (string|int|float)\.#'
      paths:
        - app/Services/Share/ShareLinkService.php
    -
      message: '#Method .+ShareLinkService::getShareLinkInfo\(\) should return .+ but returns .+#'

    # === PDFExportService: e() function with mixed values ===
    -
      message: '#Parameter \#1 \$value of function e expects .+, mixed given\.#'
      paths:
        - app/Services/Export/PDFExportService.php
    -
      message: '#Cannot cast mixed to int\.#'
      paths:
        - app/Services/Export/PDFExportService.php

    # === PushNotificationService: config() returns mixed ===
    -
      message: '#Cannot cast mixed to string\.#'
      paths:
        - app/Services/Notifications/PushNotificationService.php

    # === OpenCVPreprocessingService: intval() with config() mixed return ===
    -
      message: '#Parameter \#1 \$value of function intval expects .+, mixed given\.#'
      paths:
        - app/Services/OCR/OpenCVPreprocessingService.php

    # === PatternRecognitionService: mixed arithmetic ===
    -
      message: '#Cannot cast mixed to float\.#'
      paths:
        - app/Services/Analytics/PatternRecognitionService.php

    # === NotificationSettings: notification_preferences returns mixed ===
    -
      message: '#Property App\\Livewire\\Settings\\NotificationSettings::\$.+ \(bool\|string\) does not accept mixed\.#'
    -
      message: '#Property App\\Livewire\\Settings\\NotificationSettings::\$.+ \(bool\) does not accept mixed\.#'
    -
      message: '#Property App\\Livewire\\Settings\\NotificationSettings::\$.+ \(string\) does not accept mixed\.#'

    # === AccessibilitySettings: ArrayObject<string,mixed> vs ArrayObject<string,bool|string> ===
    -
      message: '#Property .+\$accessibility_settings .+ does not accept ArrayObject<string, .+>\.#'

    # === AIDashboardService: Eloquent Collection vs base Collection covariance ===
    -
      message: '#Parameter \#1 \$conversations of method .+calculateAverageConfidenceFromConversations\(\) expects .+, .+ given\.#'

    # === CareerComparisonAnalyticsService: Collection max/min return type inference ===
    -
      message: '#Binary operation "-" between mixed and mixed results in an error\.#'
      paths:
        - app/Services/Analytics/CareerComparisonAnalyticsService.php

