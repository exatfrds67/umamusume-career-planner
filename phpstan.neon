includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  level: 9
  paths:
    - app
    - routes
    - tests

  excludePaths:
    - phpstan-stubs/

  stubFiles:
    - phpstan-stubs/pest-test-properties.stub

  ignoreErrors:
    # Pest test properties set in beforeEach() hooks - these are dynamically assigned at runtime
    # Using wildcard to match all test properties since Pest uses dynamic property assignment
    - message: '#Access to an undefined property PHPUnit\\Framework\\TestCase::\$\w+\.#'
      path: tests/*
    
    # Laravel testing methods available through traits but not recognized by PHPStan
    - message: '#Call to an undefined method PHPUnit\\Framework\\TestCase::mock\(\)\.#'
      path: tests/*

    # Test-specific template type issues - focus on application code quality
    - message: '#Unable to resolve the template type .* in call to (method|function) .*#'
      path: tests/*
    - message: '#Parameter .* of .* expects .*, mixed given\.#'
      path: tests/*
    - message: '#Cannot access offset .* on mixed\.#'
      path: tests/*
    - message: '#Cannot cast mixed to .*\.#'
      path: tests/*
    - message: '#Method .* has parameter .* with no value type specified in iterable type array\.#'
      path: tests/*
    - message: '#Method .* return type has no value type specified in iterable type array\.#'
      path: tests/*

    # HasFactory generic type - Laravel convention, not critical
    - message: '#Class .+ uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types: TFactory#'
      path: app/Models/*

    # PHPDoc type covariance for $fillable - Laravel convention
    - message: '#PHPDoc type array<int, string> of property .+::\$fillable is not covariant with PHPDoc type list<string>#'
      path: app/Models/*

    # Missing iterableValue types in PHPDoc - non-critical documentation issue
    - message: '#has no value type specified in iterable type array#'

    # Generic Collection types - complex to fix, non-critical
    - message: '#with generic class Illuminate\\Support\\Collection but does not specify its types#'

    # Generic BelongsTo/HasMany types - Laravel convention
    - message: '#return type with generic class Illuminate\\Database\\Eloquent\\Relations\\(BelongsTo|HasMany|BelongsToMany|HasOne) does not specify its types#'
      path: app/Models/*

    # Scope methods - Laravel convention for query scopes
    - message: '#Method .+::scope\w+\(\) has no return type specified#'
      path: app/Models/*
    - message: '#Method .+::scope\w+\(\) has parameter \$query with no type specified#'
      path: app/Models/*

    # Attribute casts - Laravel convention
    - message: '#return type with generic class Illuminate\\Database\\Eloquent\\Casts\\Attribute does not specify its types#'
      path: app/Models/*

    # Collection map return type issues - complex generic inference
    - message: '#Return type of call to method Illuminate\\(Database\\Eloquent\\|Support\\)Collection.+::map\(\) contains unresolvable type#'

    # Collection callback unresolvable types
    - message: '#Parameter .+ of method Illuminate.+Collection.+::map\(\) contains unresolvable type#'

    # Unnecessary collection calls - optimization suggestion, not error
    - message: "#Called 'pluck' on Laravel collection, but could have been retrieved as a query#"

    # Always true/false conditions - often intentional defensive coding
    - message: '#Comparison operation .+ is always (true|false)#'
    - message: '#If condition is always (true|false)#'
    - message: '#Call to function is_array\(\) with array will always evaluate to true#'

    # Nullsafe operator suggestions - style preference
    - message: '#Using nullsafe property access .+ on left side of \?\? is unnecessary#'

    # Match arm always true - often intentional for exhaustive matching
    - message: '#Match arm comparison .+ is always true#'

    # Null coalesce offset suggestions
    - message: "#Offset .+ on \\*NEVER\\* on left side of \\?\\? always exists#"

    # Empty array foreach - often intentional for empty state handling
    - message: '#Empty array passed to foreach#'

    # Dead catch blocks - often intentional for future-proofing
    - message: '#Dead catch - .+ is never thrown in the try block#'

    # No error to ignore - stale ignore comments - exclude the file instead
    # - message: '#No error to ignore is reported on line#'
    #   path: app/Http/Controllers/ProfileController.php

    # PHPDoc @var tag issues in tests
    - message: '#PHPDoc tag @var with type .+ is not subtype of native type null#'
      path: tests/*

    # Pest describe call issues
    - message: '#Call to an undefined method Pest\\PendingCalls\\DescribeCall::with\(\)#'
      path: tests/*

  treatPhpDocTypesAsCertain: false
