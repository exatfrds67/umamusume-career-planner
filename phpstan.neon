includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  level: 9
  paths:
    - app
    - routes
    - tests

  stubFiles:
    - phpstan-stubs/mockery.php
    - phpstan-stubs/testcase-properties.php

  scanFiles:
    - phpstan-stubs/mockery.php
    - phpstan-stubs/testcase-properties.php

  treatPhpDocTypesAsCertain: false
