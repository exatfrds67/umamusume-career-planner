@import "tailwindcss";

@layer components {
    .btn-icon {
        @apply p-1 rounded hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors;
    }

    .card-library-item {
        @apply p-3 rounded-lg border border-gray-200 dark:border-gray-700 
               hover:border-primary-400 dark:hover:border-primary-500 
               hover:bg-primary-50 dark:hover:bg-primary-900/10 
               cursor-pointer transition-all transform hover:scale-[1.02];
    }

    .slot-number {
        @apply inline-flex items-center justify-center w-8 h-8 rounded-full font-semibold text-sm;
    }

    .friend-slot {
        @apply bg-purple-100 text-purple-600 dark:bg-purple-900 dark:text-purple-300;
    }

    .normal-slot {
        @apply bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300;
    }
    
    .modal-backdrop {
        @apply fixed inset-0 z-50 overflow-y-auto bg-gray-500 bg-opacity-75 flex items-center justify-center;
    }

    .modal-content {
        @apply bg-white dark:bg-gray-800 rounded-lg shadow-xl p-6 w-full max-w-md mx-4;
    }
}