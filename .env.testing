APP_NAME="UmamusumeCareerPlanner"
APP_ENV=testing
APP_KEY=base64:EbWoff2KGfUSGgPiC7zlnhN4bV0saWa1Vwc22hWh8qQ=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Testing uses SQLite in-memory)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
CACHE_PREFIX=umamusume-career-planner-test-

MAIL_MAILER=array

# Redis Configuration (WSL) - For tests that require Redis
# Note: WSL IP may change on restart. Check with: wsl hostname -I
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=umamusume-career-planner-test:
REDIS_DB=15
REDIS_CACHE_DB=15
REDIS_SESSION_DB=15

# Disable external services in tests
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
MCP_ENABLED=false
AI_ENABLED=false
OLLAMA_ENABLED=false
BEDROCK_ENABLED=false
AWS_BEDROCK_ENABLED=false

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_EXPIRATION=60
