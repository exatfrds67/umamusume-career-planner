APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=umamusume-career-planner-cache-

MEMCACHED_HOST=127.0.0.1

# Redis Configuration (WSL)
# Redis is running on WSL and accessible from Windows via 127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=umamusume-career-planner:
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_CACHE_CONNECTION=cache

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# External API Configuration
UMAPYOI_API_URL=https://umapyoi.net
UMAPYOI_API_TIMEOUT=30
UMAPYOI_API_ENABLED=true
UMAPYOI_CACHE_TTL=86400
UMAPYOI_MAX_RETRIES=3
UMAPYOI_RETRY_DELAY=1000

UMAMUSUMEDB_API_URL=https://api.umamusumedb.com
UMAMUSUMEDB_API_TIMEOUT=30
UMAMUSUMEDB_API_ENABLED=true
UMAMUSUMEDB_CACHE_TTL=43200
UMAMUSUMEDB_MAX_RETRIES=5
UMAMUSUMEDB_INITIAL_RETRY_DELAY=500
UMAMUSUMEDB_MAX_RETRY_DELAY=10000

CONTEXT7_ENABLED=true
CONTEXT7_CACHE_TTL=1800
CONTEXT7_MAX_HISTORY=50

# API Fallback Configuration
API_FALLBACK_ENABLED=true
API_FALLBACK_MANUAL_INPUT=true
API_FALLBACK_STALE_THRESHOLD=604800

# API Health Monitoring
API_HEALTH_CHECK_INTERVAL=300
API_HEALTH_FAILURE_THRESHOLD=3
API_HEALTH_ALERT_ENABLED=true

# API Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_HOUR=1000

# OCR Configuration (Task 5.1.1)
# Tesseract OCR Settings
TESSERACT_PATH=tesseract
TESSERACT_LANGUAGE=jpn+eng
TESSERACT_PSM=6
TESSERACT_OEM=3

# Image Processing Settings
OPENCV_ENABLED=true
OPENCV_RESIZE_MAX_WIDTH=1920
OPENCV_RESIZE_MAX_HEIGHT=1080
OPENCV_DENOISE_STRENGTH=10
OPENCV_SHARPEN_ENABLED=true
OPENCV_CONTRAST_ENHANCEMENT=true

# Image Upload Limits
IMAGE_MAX_FILE_SIZE=10485760
IMAGE_MIN_WIDTH=320
IMAGE_MIN_HEIGHT=240
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096
IMAGE_SECURITY_SCAN_ENABLED=true

# Neuron AI Configuration
# Default AI provider (anthropic, openai, ollama, gemini, mistral, deepseek, huggingface)
NEURON_AI_PROVIDER=anthropic

# Anthropic (Claude) Configuration
ANTHROPIC_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI Configuration
OPENAI_KEY=
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT=30

# Ollama Configuration (Local AI)
OLLAMA_URL=http://localhost:11434/api
OLLAMA_MODEL=llama2

# AI Hybrid System Configuration
# Enable hybrid AI routing (automatic provider selection)
AI_HYBRID_ENABLED=true

# Ollama Local AI Configuration
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.3
OLLAMA_TIMEOUT=30
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=2048
OLLAMA_API_KEY=

# AWS Bedrock Cloud AI Configuration
BEDROCK_ENABLED=true
BEDROCK_DEFAULT_MODEL=claude-3-5-sonnet
BEDROCK_MODEL_PREFERENCES=claude-3-5-sonnet,nova-2-lite
BEDROCK_TIMEOUT=30
BEDROCK_TEMPERATURE=0.3
BEDROCK_MAX_TOKENS=4096

# MCP (Model Context Protocol) Configuration
MCP_ENABLED=false
MCP_DEBUG=false

# Gemini Configuration
GEMINI_KEY=
GEMINI_MODEL=gemini-pro

# Mistral Configuration
MISTRAL_KEY=
MISTRAL_MODEL=mistral-large-latest

# DeepSeek Configuration
DEEPSEEK_KEY=
DEEPSEEK_MODEL=deepseek-chat

# HuggingFace Configuration
HUGGINGFACE_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-hf

# Embedding Provider Configuration (for RAG - optional)
NEURON_EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VOYAGE_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3
MISTRAL_BASE_URI=https://api.mistral.ai/v1/embeddings
MISTRAL_EMBEDDING_MODEL=mistral-embed

# Vector Store Configuration (for RAG - optional)
NEURON_STORE_PROVIDER=file
PINECONE_KEY=
PINECONE_INDEX_URL=
QDRANT_COLLECTION_URL=
QDRANT_KEY=
MEILISEARCH_INDEX_UID=
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=
CHROMA_COLLECTION=
CHROMA_HOST=http://localhost:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_KEY=

# Inspector Monitoring (optional)
# Inspector provides real-time monitoring and debugging for AI agent execution
# Sign up at https://inspector.dev to get your ingestion key
# Tracks: agent execution times, tool calls, token usage, error rates, response quality
# Leave empty to disable monitoring (recommended for local development)
INSPECTOR_INGESTION_KEY=

# MCP Connector Configuration (optional)
# Model Context Protocol allows agents to connect to pre-built tools and integrations
# Enable MCP connector to use external MCP servers with Neuron AI agents
NEURON_MCP_ENABLED=false

# Local MCP Servers
# These servers run as command-line processes on the same machine
NEURON_MCP_MEMORY_ENABLED=false
NEURON_MCP_FILESYSTEM_ENABLED=false
NEURON_MCP_FETCH_ENABLED=false

# Remote MCP Servers
# These servers are accessed via HTTP/HTTPS URLs with authentication
NEURON_MCP_UMAPYOI_ENABLED=false
NEURON_MCP_UMAPYOI_URL=https://api.umapyoi.net/mcp
NEURON_MCP_UMAPYOI_TOKEN=

NEURON_MCP_CUSTOM_API_ENABLED=false
NEURON_MCP_CUSTOM_API_URL=
NEURON_MCP_CUSTOM_API_TOKEN=

# MCP Connection Settings
NEURON_MCP_TIMEOUT=30
NEURON_MCP_RETRY_ATTEMPTS=3
NEURON_MCP_RETRY_DELAY=1000
